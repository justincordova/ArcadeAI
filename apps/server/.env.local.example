# Local Supabase Auth mode. Copy to apps/server/.env.local for `bun run dev`.
AUTH_MODE=supabase
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json

# Kept for the current application data store while the Postgres migration is
# rolled out. `bun run db:migrate:local` uses the Supabase database separately.
DATABASE_PATH=./data/arcadeai.db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=local-only-change-me
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=false

# Optional for game generation.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
