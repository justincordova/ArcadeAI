# Copy to apps/web/.env.local for the local Supabase email/password flow.
VITE_API_BASE=http://127.0.0.1:3000
VITE_SUPABASE_URL=http://127.0.0.1:55321
# Run `bun run supabase:status` and copy the printed Publishable key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_supabase_status_value
