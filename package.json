{
  "name": "arcadeai",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:local": "bun run supabase:start && bun run dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "db:migrate": "bun run --filter @arcadeai/db migrate",
    "db:generate": "bun run --filter @arcadeai/db generate",
    "db:studio": "bun run --filter @arcadeai/db studio",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset && bun run db:migrate:local",
    "db:migrate:local": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres bun run --filter @arcadeai/db migrate:postgres"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "typescript": "^7.0.2"
  }
}
