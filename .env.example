# LLM Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Auth
BETTER_AUTH_SECRET=<generate with: openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3000

# OAuth credentials
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# Admin allowlist (comma-separated emails get tier='admin' on first sign-in)
ADMIN_EMAILS=you@example.com

# Database — leave unset to use the default (apps/server/data/arcadeai.db
# resolved from the server package, regardless of cwd). Override with an
# absolute path if you need to pin to a specific location.
# DATABASE_PATH=/absolute/path/to/arcadeai.db

# Server
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Set to true in production when running behind a reverse proxy / load
# balancer so req.ip resolves the real client IP from X-Forwarded-For
# (the rate limiter keys on it). Leave false for directly-exposed servers.
TRUST_PROXY=false
