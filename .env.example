# LLM Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Supabase Auth + PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Admin allowlist (comma-separated emails get tier='admin' on first sign-in)
ADMIN_EMAILS=you@example.com

# Server
PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Set to true in production when running behind a reverse proxy / load
# balancer so req.ip resolves the real client IP from X-Forwarded-For
# (the rate limiter keys on it). Leave false for directly-exposed servers.
TRUST_PROXY=false

# Web (build-time only)
# Baked into the SPA bundle by `vite build` — it is NOT read at runtime, so
# setting it on the server has no effect. Defaults to http://localhost:3000
# when unset, which means a production build that forgets it ships a bundle
# whose every request goes to localhost. Set to an empty string when the API
# is served from the same origin as the SPA (what the Dockerfile does).
VITE_API_BASE=http://localhost:3000
