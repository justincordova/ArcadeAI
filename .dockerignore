# Docker only respects .dockerignore (not .gitignore) when building the
# context — without this file, `COPY . .` baked the local .env (real
# secrets, extractable from any image layer) and the local SQLite DB
# (real user/session data) into the production image. Bun also auto-loads
# /app/.env at startup, so a stowaway dev .env silently backfills any key
# not set as a Fly secret, defeating env.ts's fail-fast validation.

# Secrets — keep the example template only
.env
.env.*
!.env.example

# Local databases (the volume-mounted prod DB lives outside the image)
apps/server/data
*.db
*.db-journal
*.db-wal
*.db-shm

# Host dependencies (macOS-native binaries must not overlay the Linux
# install performed inside the Dockerfile) and build outputs
node_modules
**/node_modules
apps/web/dist

# VCS and local tooling
.git
.github
.DS_Store
